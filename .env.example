# Chaves aceitas pelo provider-fake. Não são segredos reais: só funcionam contra ele.
# Hoje lidas pelo app (v1) e pelo gateway. Na v2-decoupled saem do ambiente do app (Passo 09).
FAKE_OPENAI_KEY=sk-fake-openai-0001
FAKE_ANTHROPIC_KEY=sk-ant-fake-0001

# Chave própria do AI Gateway (LiteLLM exige o prefixo "sk-"). Valor de desenvolvimento local.
# Provisória: é a master key; chaves virtuais por consumidor entram no Passo 12.
# O compose a entrega à app como GATEWAY_API_KEY (Passo 08).
GATEWAY_MASTER_KEY=sk-gateway-local-0001
