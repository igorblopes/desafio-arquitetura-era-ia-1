# Chaves aceitas pelo provider-fake. Não são segredos reais: só funcionam contra ele.
# Entregues só ao gateway e ao provider-fake; a app não as recebe (v2-decoupled).
FAKE_OPENAI_KEY=sk-fake-openai-0001
FAKE_ANTHROPIC_KEY=sk-ant-fake-0001

# Chave própria do AI Gateway (LiteLLM exige o prefixo "sk-"). Valor de desenvolvimento local.
# É a MASTER KEY: só administra o gateway. Vai ao gateway e ao serviço de bootstrap, nunca à app.
GATEWAY_MASTER_KEY=sk-gateway-local-0001

# Senha do banco de governança do gateway (Postgres local, ADR 0007). Só gateway e banco a recebem.
GATEWAY_DB_PASSWORD=litellm-local-0001

# Chaves VIRTUAIS de consumo (ADR 0010). Valores fixos de desenvolvimento local: o bootstrap
# (gateway/scripts/bootstrap_keys.py) cria cada uma no gateway com esse valor e a sua política,
# então ninguém precisa copiar chave gerada. A app recebe só a HELPDESK_GATEWAY_KEY.
HELPDESK_GATEWAY_KEY=sk-helpdesk-local-0001
# Só para os roteiros de governança do README (chamadas diretas ao gateway na porta 4000).
GOVERNANCE_BUDGET_KEY=sk-governance-budget-local-0001
GOVERNANCE_RATE_KEY=sk-governance-rate-local-0001
